<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFrameworks>net8.0</TargetFrameworks>
    <Configuration>'$(Configuration)'</Configuration>
    <FileVersion>1.0.0.0</FileVersion>
    <OutputType>Library</OutputType>

    <RootNamespace>JasonPereira84.Result.Exception</RootNamespace>
    <AssemblyName>JasonPereira84.Result.Exception</AssemblyName>
    <AssemblyTitle>JasonPereira84's Result.Exception library</AssemblyTitle>
    <Description>Interfaces definitions for IResult, IResult&lt;TError&gt; &amp; IResult&lt;TError, TValue&gt;. Struct definitions for Result, Result&lt;TValue&gt;, Result&lt;TError, TValue&gt;. Helper methods etc. as Extensions</Description>
    <DocumentationFile></DocumentationFile>

    <ProjectGuid>{33a4d950-ae87-47d3-9a28-89931a515868}</ProjectGuid>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageId>JasonPereira84.Result.Exception</PackageId>
    <Title>JasonPereira84's Result.Exception library</Title>
    <PackageDescription>Interfaces definitions for IResult, IResult&lt;TError&gt; &amp; IResult&lt;TError, TValue&gt;. Struct definitions for Result, Result&lt;TValue&gt;, Result&lt;TError, TValue&gt;. Helper methods etc. as Extensions</PackageDescription>
    <PackageTags>C#, Library, Utils, Result.Exception</PackageTags>
    <RepositoryUrl>https://github.com/jasonpereira84/Result</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Authors>jasonpereira84@gmail.com</Authors>
    <Version>8.0.0</Version>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants />
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
